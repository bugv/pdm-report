@article{szymanski2023ARROWSAutonomous,
  title = {{{ARROWS}} : {{Autonomous}} and Dynamic Precursor Selection for Solid-State Materials Synthesis},
  author = {Szymanski, Nathan J. and Nevatia, Pragnay and Bartel, Christopher J. and Zeng, Yan and Ceder, Gerbrand},
  year = 2023,
  month = oct,
  journal = {Nat Commun},
  volume = {14},
