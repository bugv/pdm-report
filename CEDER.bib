@article{zeng2024SelectiveFormation,
  title = {Selective Formation of Metastable Polymorphs in Solid-State Synthesis},
  author = {Zeng, Yan and Szymanski, Nathan J. and He, Tanjin and Jun, KyuJung and Gallington, Leighanne C. and Huo, Haoyan and Bartel, Christopher J. and Ouyang, Bin and Ceder, Gerbrand},
  year = 2024,
  month = jan,
  journal = {Sci. Adv.},
  volume = {10},
