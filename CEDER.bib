  title = {The Stability of the Phases in the {{{\emph{Ln}}}}{{2O3}}{{FeO}}{{Fe2O3}} Systems Which Are Stable at Elevated Temperatures ({{{\emph{Ln}}}}: {{Lanthanide}} Elements and {{Y}})},
