  author = {Tan, Shibo and Kamm, Gabrielle E. and Stangel, Alex and Chao, Paul and Mensah, Alexander and Venkatesh, Varun Srinivas and Maria, Eymana and Agarwal, Nishkarsh and Baek, Woohyeon and Ferrari, John and Thornton, Katsuyo and Shahani, Ashwin and Hovden, Robert and Chapman, Karena W. and Sun, Wenhao},
