@article{miura2021ObservingModeling,
  title = {Observing and {{Modeling}} the {{Sequential Pairwise Reactions}} That {{Drive Solid}}-{{State Ceramic Synthesis}}},
  author = {Miura, Akira and Bartel, Christopher J. and Goto, Yosuke and Mizuguchi, Yoshikazu and Moriyoshi, Chikako and Kuroiwa, Yoshihiro and Wang, Yongming and Yaguchi, Toshie and Shirai, Manabu and Nagao, Masanori and Rosero-Navarro, Nataly Carolina and Tadanaga, Kiyoharu and Ceder, Gerbrand and Sun, Wenhao},
